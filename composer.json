{
    "name": "omatech/editora-laravel-connector-dbinterface",
    "description": "Laravel frontend connector for Editora content and media",
    "minimum-stability": "dev",
    "require": {
        "omatech/editora-dbinterface": "^1.8.0"
    },
    "require-dev": {
        "aws/aws-sdk-php": "3.401.5",
        "laravel/framework": "13.42.0",
        "phpunit/phpunit": "13.4.6"
    },
    "suggest": {
        "aws/aws-sdk-php": "Required by Media\\PublicMediaController to serve media from a private S3 bucket"
    },
    "autoload": {
        "psr-4": {
            "Omatech\\": "src/Omatech"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Omatech\\Editora\\Connector\\ConnectorServiceProvider"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true,
        "platform": {
            "php": "8.5.12"
        }
    },
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit --testsuite Connector",
        "lint": "@php tests/lint.php",
        "check": [
            "@lint",
            "@test",
            "@composer validate --no-check-publish",
            "@composer audit --locked"
        ]
    }
}
